# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Seed script and auth admin ONLY.
# Never import this in agent/ or in any client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The agent's own Supabase login (created in Task 13)
#
# The agent signs in as an ordinary user and is subject to RLS like anyone
# else. This is the entire premise of the project — see docs/specs/.
# ---------------------------------------------------------------------------
AGENT_EMAIL=agent@eve-the-accountant.demo
AGENT_PASSWORD=

# ---------------------------------------------------------------------------
# Shared secret: Database Webhook → session bootstrap route.
# Also forwarded to eve, which is what gives that turn a `machine` principal
# and therefore makes the approval gate fire. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Vercel AI Gateway — local development only.
# On Vercel, OIDC authenticates the deployment and no key is set.
# Dashboard → AI Gateway → API Keys
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
